{
  "name": "n-queen-algorithm-tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:solvers": "node driver/scripts/build-solvers.mjs",
    "dev": "vite --config driver/vite.config.ts",
    "build": "tsc --noEmit && vite build --config driver/vite.config.ts",
    "preview": "vite preview --config driver/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx driver/bench/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
